pipeline {
    agent { label 'AGENT-1' }
    environment{
        PROJECT = 'expense'
        COMPONENT = 'backend'
        appversion =''
    }
    options{
        disableConcurrentBuilds()
        timeout( time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Read Version') {
            steps {
                script{
                    def packageJson = readJson file: 'package.json'
                    appversion = packageJson.version
                    echo" version is : ${appversion} "
                }
            }
        }

        

    }
    post { 
        always { 
            echo 'I will always say Hello again!'
        }
    }
}
