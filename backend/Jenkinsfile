pipeline {
    agent { label 'AGENT-1' }

    environment {
        PROJECT   = 'expense'
        COMPONENT = 'backend'
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {

        stage('Checkout Code') {
            steps {
                deleteDir()          // clean workspace
                checkout scm
            }
        }

        stage('Debug Files') {
            steps {
                sh 'pwd'
                sh 'ls -R'
            }
        }

        stage('Read Version') {
            steps {
                script {
                    def packageJson = readJSON file: 'backend/package.json'
                    env.APP_VERSION = packageJson.version
                    echo "Application Version is: ${env.APP_VERSION}"
                }
            }
        }

        stage('Print Info') {
            steps {
                echo "Project: ${PROJECT}"
                echo "Component: ${COMPONENT}"
                echo "Version: ${env.APP_VERSION}"
            }
        }

    }

    post {
        always {
            echo 'Pipeline execution completed.'
        }
        success {
            echo 'Build SUCCESS ✅'
        }
        failure {
            echo 'Build FAILED ❌'
        }
    }
}

